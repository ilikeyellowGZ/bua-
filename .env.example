# Public values embedded in the Expo bundle. Never place service-role or AI provider keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO_MODE=true
# Optional: enables real crash/error reporting. Omit to keep the console-only monitoring fallback.
EXPO_PUBLIC_SENTRY_DSN=

# Server-only values belong in the local untracked .env or the Supabase/EAS secret store.
SUPABASE_SECRET_KEY=replace_me_server_only
SUPABASE_JWK_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
OPENROUTER_API_KEY=replace_me_server_only
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace_me
AI_DAILY_LIMIT=20
