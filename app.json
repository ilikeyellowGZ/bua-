{
  "expo": {
    "name": "Bua",
    "slug": "bua",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "bua",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bua.learn",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bua uses your microphone so you can practise speaking and get pronunciation feedback."
      }
    },
    "android": {
      "package": "com.bua.learn",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10243B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7EF",
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#2B9C91"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
