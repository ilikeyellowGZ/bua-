{
  "name": "bua",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all --output-dir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor@latest",
    "assets:extract": "node scripts/extract-approved-assets.mjs && node scripts/extract-approved-scenes.mjs",
    "capture:components": "node scripts/capture-component-showcase.mjs",
    "capture:product-slice": "node scripts/capture-product-slice.mjs",
    "capture:lesson-slice": "node scripts/capture-lesson-slice.mjs",
    "env:prepare": "node scripts/prepare-env.mjs",
    "serve:dist": "node scripts/serve-static.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test -- --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "xstate": "^5.32.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "57.0.7",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**"
    ]
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
